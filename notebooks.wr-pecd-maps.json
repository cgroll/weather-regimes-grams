{"version":3,"kind":"Notebook","sha256":"453fe2635f35cab1db44c5b971c0252b8a7dca03e1adb25ff2981b9f6cfc3004","slug":"notebooks.wr-pecd-maps","location":"/notebooks/11_wr_pecd_maps.ipynb","dependencies":[],"frontmatter":{"title":"Weather Regime Maps — Mean CF by Country","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"authors":[{"nameParsed":{"literal":"Your Name","given":"Your","family":"Name"},"name":"Your Name","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cgroll/weather-regimes-grams","copyright":"2026","numbering":{"title":{"offset":1}},"source_url":"https://github.com/cgroll/weather-regimes-grams/blob/main/book/notebooks/11_wr_pecd_maps.ipynb","edit_url":"https://github.com/cgroll/weather-regimes-grams/edit/main/book/notebooks/11_wr_pecd_maps.ipynb","thumbnail":"/weather-regimes-grams/build/11_wr_maps_no-bd2f2e8be961b4865a349cef8177068e.png","exports":[{"format":"ipynb","filename":"11_wr_pecd_maps.ipynb","url":"/weather-regimes-grams/build/11_wr_pecd_maps-0cac049541256c6805e825bbf4c8fc63.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For each weather regime (and “no regime”), shows the mean capacity factor\nacross all European countries as a choropleth map. Three generation types\nare shown side by side: solar PV, wind onshore, wind offshore.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PTmmF9Pzaz"}],"key":"WiB46XIWEe"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Data: PECD (hourly, 1979–2026) resampled to daily; Grams lifecycle\nattribution resampled to daily dominant regime.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"UZ2MxUi774"}],"key":"lndPneMsCc"}],"key":"VcfxWI1mwE"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-21T09:22:35.148630Z","iopub.status.busy":"2026-05-21T09:22:35.148512Z","iopub.status.idle":"2026-05-21T09:22:35.646137Z","shell.execute_reply":"2026-05-21T09:22:35.645451Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport matplotlib.colors as mcolors\nimport geopandas as gpd\nimport shapely.geometry as sg\nfrom pathlib import Path\n\n_CMAP_CF   = plt.get_cmap(\"PiYG\")       # green = positive CF anomaly, pink = negative\n_CMAP_TEMP = plt.get_cmap(\"coolwarm\")   # red = warmer than average, blue = cooler\n\nfrom wr.paths import ProjPaths\nfrom wr.regimes import BY_INDEX, WR_NAMES\n\npaths = ProjPaths()\n\nPECD_PATH   = \"/home/chris/research/world-of-energy/data/processed/pecd/pecd_regions.parquet\"\nNE_SHP      = \"/home/chris/.local/share/cartopy/shapefiles/natural_earth/cultural/ne_10m_admin_0_countries.shp\"\n\n# European projection (ETRS89-LAEA)\nPROJ_CRS = \"EPSG:3035\"\n\n# PECD uses EL (Greece) and UK (Britain); naturalearth uses GR and GB\nPECD_TO_ISO = {\"EL\": \"GR\", \"UK\": \"GB\"}","key":"fGJueuGIHy"},{"type":"outputs","id":"Bv9fgp5STSYdrH8J61vH0","children":[],"key":"UcWdmfCIjy"}],"key":"ieCNhozIjA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load world shapefile","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E9ifmMYyAT"}],"identifier":"load-world-shapefile","label":"Load world shapefile","html_id":"load-world-shapefile","implicit":true,"key":"ymnQGoR1It"}],"key":"HnWPFzsbgF"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-21T09:22:35.648033Z","iopub.status.busy":"2026-05-21T09:22:35.647846Z","iopub.status.idle":"2026-05-21T09:22:36.061033Z","shell.execute_reply":"2026-05-21T09:22:36.060375Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"world_raw = gpd.read_file(NE_SHP)\n\n# Build a single effective ISO2 column: prefer ISO_A2, fall back to ISO_A2_EH\nworld_raw[\"iso2\"] = world_raw[\"ISO_A2\"].where(\n    world_raw[\"ISO_A2\"] != \"-99\", world_raw[\"ISO_A2_EH\"]\n)\n\nworld = world_raw[[\"iso2\", \"NAME\", \"geometry\"]].copy()\nworld = world.to_crs(PROJ_CRS)\n\n# Clip world to a European geographic bounding box so the background plot never\n# expands the axis limits beyond Europe (lon -27..50, lat 27..73 covers all PECD\n# countries including Iceland, Turkey, and the Canaries).\neu_bbox = gpd.GeoDataFrame(\n    geometry=[sg.box(-27, 27, 50, 73)], crs=\"EPSG:4326\"\n).to_crs(PROJ_CRS)\nworld_eu = gpd.clip(world, eu_bbox)","key":"egEVXWVjvO"},{"type":"outputs","id":"DEOFacsWJs2V0h6cPFNrS","children":[],"key":"YpESc5AM8T"}],"key":"gSiveR653A"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load and align PECD + regime data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ROp8mYJ92f"}],"identifier":"load-and-align-pecd-regime-data","label":"Load and align PECD + regime data","html_id":"load-and-align-pecd-regime-data","implicit":true,"key":"bY9goDGbAQ"}],"key":"Pcii0bXYhi"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-21T09:22:36.063472Z","iopub.status.busy":"2026-05-21T09:22:36.063284Z","iopub.status.idle":"2026-05-21T09:22:40.113901Z","shell.execute_reply":"2026-05-21T09:22:40.113065Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"pecd = pd.read_parquet(PECD_PATH)\n\nsolar_h   = pecd[\"solar_photovoltaic_power_generation\"][\"capacity_factor_ratio\"]\nwind_on_h = pecd[\"wind_power_generation_onshore\"][\"capacity_factor_ratio\"]\ntemp_h    = pecd[\"2m_air_temperature\"][\"value\"] - 273.15   # K → °C\n\n# Daily means — solar NaN (night) are skipped automatically\nsolar_d   = solar_h.resample(\"D\").mean()\nwind_on_d = wind_on_h.resample(\"D\").mean()\ntemp_d    = temp_h.resample(\"D\").mean()\n\n# LC attribution: daily dominant regime (1950–2025, 3-hourly → daily mode)\nlc = pd.read_csv(paths.lc_attribution_csv, parse_dates=[\"datetime\"], index_col=\"datetime\")\nlc_daily = (\n    lc[\"lifecycle_wr_index\"]\n    .resample(\"D\")\n    .agg(lambda x: x.mode().iloc[0] if len(x) > 0 else np.nan)\n    .astype(float)\n)\n\n# Restrict to overlap period (1979 onwards)\nlc_daily = lc_daily.reindex(solar_d.index)\n\nprint(\"Overlap period:\", solar_d.index.min().date(), \"→\", solar_d.index.max().date())\nprint(\"Days per regime:\")\nfor i in range(8):\n    n = (lc_daily == i).sum()\n    print(f\"  {BY_INDEX[i]['name']:>5}: {n:5d} days\")","key":"xs9kjyXCSc"},{"type":"outputs","id":"uOOE0mB8F3kkLI93tUM6i","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Overlap period: 1979-01-01 → 2026-01-31\nDays per regime:\n     no:  5251 days\n     AT:  1573 days\n     ZO:  1572 days\n   ScTr:  1757 days\n     AR:  1559 days\n   EuBL:  1717 days\n   ScBL:  1857 days\n     GL:  1723 days\n"},"children":[],"key":"v02IhTT114"}],"key":"igM3WeIFix"}],"key":"Y9MzFwABad"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compute per-regime anomalies (deviation from overall mean)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VPINw07tqy"}],"identifier":"compute-per-regime-anomalies-deviation-from-overall-mean","label":"Compute per-regime anomalies (deviation from overall mean)","html_id":"compute-per-regime-anomalies-deviation-from-overall-mean","implicit":true,"key":"bUw5XDIb6y"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For each country and variable, the anomaly for a regime is:\nregime_mean_CF - overall_mean_CF\nRed = above average, blue = below average.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kzzlILas66"}],"key":"HgALDE5kwt"}],"key":"VdfJn3bsC3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-21T09:22:40.115700Z","iopub.status.busy":"2026-05-21T09:22:40.115580Z","iopub.status.idle":"2026-05-21T09:22:40.143755Z","shell.execute_reply":"2026-05-21T09:22:40.142991Z"},"lines_to_next_cell":1},"children":[{"type":"code","lang":"python","executable":true,"value":"REGIME_IDS = list(range(8))\n\n# Overall mean across all days (used as the baseline)\nsolar_clim   = solar_d.mean()\nwind_on_clim = wind_on_d.mean()\ntemp_clim    = temp_d.mean()\n\ndef regime_anomalies(cf_daily: pd.DataFrame, clim: pd.Series,\n                     lc: pd.Series) -> dict[int, pd.Series]:\n    \"\"\"Return {regime_idx: Series(country → mean anomaly)} for each regime.\"\"\"\n    out = {}\n    for i in REGIME_IDS:\n        mask = lc == i\n        out[i] = cf_daily.loc[mask].mean() - clim\n    return out\n\nsolar_means   = regime_anomalies(solar_d,   solar_clim,   lc_daily)\nwind_on_means = regime_anomalies(wind_on_d, wind_on_clim, lc_daily)\ntemp_means    = regime_anomalies(temp_d,    temp_clim,    lc_daily)","key":"bF2VKHZFVy"},{"type":"outputs","id":"AwQowfREKdJso0XuCC5XF","children":[],"key":"kfobSSs7eE"}],"key":"eNLkmvRQRG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Symmetric diverging colour scales (shared across all regimes)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vfSDDhjKGL"}],"identifier":"symmetric-diverging-colour-scales-shared-across-all-regimes","label":"Symmetric diverging colour scales (shared across all regimes)","html_id":"symmetric-diverging-colour-scales-shared-across-all-regimes","implicit":true,"key":"bBJR411chD"}],"key":"AyyLpdr1bf"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-21T09:22:40.145450Z","iopub.status.busy":"2026-05-21T09:22:40.145334Z","iopub.status.idle":"2026-05-21T09:22:40.153031Z","shell.execute_reply":"2026-05-21T09:22:40.152365Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def _abs_max(anom_dict):\n    return pd.concat(anom_dict.values()).dropna().abs().quantile(0.97)\n\nsolar_lim   = _abs_max(solar_means)\nwind_on_lim = _abs_max(wind_on_means)\ntemp_lim    = _abs_max(temp_means)\n\nCMAPS = {\n    \"solar\":   (_CMAP_CF,   -solar_lim,   solar_lim),\n    \"wind_on\": (_CMAP_CF,   -wind_on_lim, wind_on_lim),\n    \"temp\":    (_CMAP_TEMP, -temp_lim,    temp_lim),\n}\nCF_VARS  = list(CMAPS.keys())\nCF_TITLES = {\n    \"solar\":   \"Solar PV CF anomaly\",\n    \"wind_on\": \"Wind onshore CF anomaly\",\n    \"temp\":    \"2 m temperature anomaly (°C)\",\n}\n\nprint(\"Colour scale limits (±):\")\nfor k, (cmap, vmin, vmax) in CMAPS.items():\n    print(f\"  {k}: ±{vmax:.4f}\")","key":"mdTAgyDrn9"},{"type":"outputs","id":"_ZBuFbtEJLq2Shdge-d3P","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Colour scale limits (±):\n  solar: ±0.0329\n  wind_on: ±0.1499\n  temp: ±3.4394\n"},"children":[],"key":"XXvSkzUjSg"}],"key":"ZPD9914ZWf"}],"key":"iHtWVtgOt6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Map extent and helper","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dbnqKK6FW5"}],"identifier":"map-extent-and-helper","label":"Map extent and helper","html_id":"map-extent-and-helper","implicit":true,"key":"TCc9VCrNRh"}],"key":"eOLnfSP8ir"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-21T09:22:40.154378Z","iopub.status.busy":"2026-05-21T09:22:40.154268Z","iopub.status.idle":"2026-05-21T09:22:40.160452Z","shell.execute_reply":"2026-05-21T09:22:40.159448Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Hard-coded EPSG:3035 extent for mainland Europe\n# (avoids Atlantic island territories like Azores/Canaries expanding the bbox)\nXLIM = (2_600_000, 7_000_000)\nYLIM = (1_400_000, 5_500_000)\n\nall_iso_ne = [PECD_TO_ISO.get(c, c) for c in solar_d.columns]\n\n\ndef make_regime_map(regime_idx: int) -> plt.Figure:\n    \"\"\"One figure with 3 horizontal subplots for a single regime.\"\"\"\n    regime_name = BY_INDEX[regime_idx][\"name\"]\n    regime_color = BY_INDEX[regime_idx][\"color\"]\n\n    means_lookup = {\n        \"solar\":   solar_means[regime_idx],\n        \"wind_on\": wind_on_means[regime_idx],\n        \"temp\":    temp_means[regime_idx],\n    }\n\n    fig, axes = plt.subplots(1, 3, figsize=(18, 7))\n\n    for ax, cf_var in zip(axes, CF_VARS):\n        cmap, vmin, vmax = CMAPS[cf_var]\n        norm = mcolors.Normalize(vmin=vmin, vmax=vmax)\n\n        # Build per-country CF series → join to shapefile\n        cf_series = means_lookup[cf_var].rename(\"cf\")\n        cf_series.index = [PECD_TO_ISO.get(c, c) for c in cf_series.index]\n        cf_df = cf_series.reset_index().rename(columns={\"index\": \"iso2\"})\n\n        geo = world.merge(cf_df, on=\"iso2\", how=\"left\")\n\n        # Ocean background + European countries (grey background)\n        # Use world_eu (clipped to Europe) so geopandas never expands axis limits\n        # beyond the European bounding box.\n        ax.set_facecolor(\"#d6eaf8\")\n        world_eu.plot(ax=ax, color=\"#cccccc\", linewidth=0.3, edgecolor=\"white\")\n\n        # PECD countries coloured by CF\n        has_data = geo[geo[\"cf\"].notna()]\n        no_data  = geo[geo[\"cf\"].isna() & geo[\"iso2\"].isin(all_iso_ne)]\n\n        if len(has_data):\n            has_data.plot(ax=ax, column=\"cf\", cmap=cmap,\n                          vmin=vmin, vmax=vmax,\n                          linewidth=0.4, edgecolor=\"white\")\n        if len(no_data):\n            # PECD country but variable not available (e.g. landlocked → no offshore)\n            no_data.plot(ax=ax, color=\"#eeeeee\", linewidth=0.4, edgecolor=\"white\")\n\n        # Colorbar\n        sm = plt.cm.ScalarMappable(cmap=cmap, norm=norm)\n        sm.set_array([])\n        cbar = fig.colorbar(sm, ax=ax, fraction=0.03, pad=0.02, orientation=\"vertical\")\n        cbar.set_label(\"°C anomaly\" if cf_var == \"temp\" else \"CF anomaly\", fontsize=10)\n        cbar.ax.tick_params(labelsize=9)\n\n        ax.set_xlim(XLIM)\n        ax.set_ylim(YLIM)\n        ax.set_axis_off()\n        ax.set_title(CF_TITLES[cf_var], fontsize=12, pad=6)\n\n    fig.suptitle(\n        f\"Regime: {regime_name} — CF anomaly vs overall mean, by country (1979–2025)\",\n        fontsize=14, fontweight=\"bold\",\n        color=regime_color if regime_name != \"no\" else \"dimgrey\",\n        y=1.01,\n    )\n    fig.tight_layout()\n    return fig","key":"xF7l30rgS7"},{"type":"outputs","id":"aUX_IgVw8sX35QGxXPq4y","children":[],"key":"mAdLAurxvh"}],"key":"iIia9YSjfb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Generate one map per regime","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yuf1G2kwGV"}],"identifier":"generate-one-map-per-regime","label":"Generate one map per regime","html_id":"generate-one-map-per-regime","implicit":true,"key":"ZfBXEmdZZn"}],"key":"NA8NWPfIwN"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-21T09:22:40.161781Z","iopub.status.busy":"2026-05-21T09:22:40.161675Z","iopub.status.idle":"2026-05-21T09:22:55.996551Z","shell.execute_reply":"2026-05-21T09:22:55.995944Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"for regime_idx in REGIME_IDS:\n    name = BY_INDEX[regime_idx][\"name\"]\n    fig = make_regime_map(regime_idx)\n    out_path = paths.images_path / f\"11_wr_maps_{name}.png\"\n    fig.savefig(out_path, dpi=150, bbox_inches=\"tight\")\n    plt.close(fig)\n    print(f\"Saved {out_path.name}\")","key":"kAYne0pJx3"},{"type":"outputs","id":"5vdeFeq8-XarvYywxbbhh","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved 11_wr_maps_no.png\n"},"children":[],"key":"SiwKRDZz0O"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved 11_wr_maps_AT.png\n"},"children":[],"key":"RhHoDTkVPc"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved 11_wr_maps_ZO.png\n"},"children":[],"key":"vL8Gyz0Um8"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved 11_wr_maps_ScTr.png\n"},"children":[],"key":"cvEvvTO9Qt"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved 11_wr_maps_AR.png\n"},"children":[],"key":"Uy4mJCwn0m"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved 11_wr_maps_EuBL.png\n"},"children":[],"key":"X8Fkcaw2te"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved 11_wr_maps_ScBL.png\n"},"children":[],"key":"pwmkDe84G2"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved 11_wr_maps_GL.png\n"},"children":[],"key":"GRTbrDi2kk"}],"key":"v1TbpPNgzW"}],"key":"yoZFED32hN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Display maps","position":{"start":{"line"