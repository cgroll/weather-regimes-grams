ded by the weight corresponding to the\ncalendar date of interest.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hjHHwGsLoy"}],"key":"Fwhzo8DUtJ"}],"key":"c4g2lwnnwy"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-15T08:56:51.685041Z","iopub.status.busy":"2026-05-15T08:56:51.684880Z","iopub.status.idle":"2026-05-15T08:56:51.702820Z","shell.execute_reply":"2026-05-15T08:56:51.702328Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"with nc.Dataset(paths.grams_eofs) as ds:\n    normwgt  = ds.variables[\"normwgt\"][:]   # (1464,) — 6-hourly, one leap year\n    nrmtimes = ds.variables[\"time\"][:]      # hours since 1980-01-01 00:00, step=6\n\nprint(f\"normwgt shape : {normwgt.shape}  (6-hourly steps in a leap year)\")\nprint(f\"time range    : {nrmtimes[0]} – {nrmtimes[-1]} h  \"\n      f\"({len(nrmtimes)} steps × 6 h = {len(nrmtimes)*6/24:.0f} days)\")","key":"jZkrMwdKyz"},{"type":"outputs","id":"bJij2ER1royjNNLxUCs-Z","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"normwgt shape : (1464,)  (6-hourly steps in a leap year)\ntime range    : 0 – 8778 h  (1464 steps × 6 h = 366 days)\n"},"children":[],"key":"W0VC5E7cBH"}],"key":"YOWvHcDsRf"}],"key":"F9uzFVyLja"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 2 — Load regime patterns and standardisation parameters","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eidY3ufaiO"}],"identifier":"step-2-load-regime-patterns-and-standardisation-parameters","label":"Step 2 — Load regime patterns and standardisation parameters","html_id":"step-2-load-regime-patterns-and-standardisation-parameters","implicit":true,"key":"rb6zny8ENE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"Normed_Z0500-patterns_EOFdomain.nc","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XcPHdK6sT5"},{"type":"text","value":" holds the 7 normalised regime patterns\non the EOF domain (lat 30–90 °N, lon 80 °W–40 °E, 0.5° resolution →\n121 × 241 gridpoints).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PokYAbXQcy"}],"key":"bHoFcsW0DB"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"inlineCode","value":"WRI_std_params.txt","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"D7bieIbmDk"},{"type":"text","value":" provides the reference mean and standard deviation of\nthe raw projections (computed over 1979–2019) used to standardise them into\nIWR values.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"qVHODQ8QhU"}],"key":"LEe8oEiO9N"}],"key":"eDPpWXzDd4"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-15T08:56:51.704276Z","iopub.status.busy":"2026-05-15T08:56:51.704151Z","iopub.status.idle":"2026-05-15T08:56:51.715138Z","shell.execute_reply":"2026-05-15T08:56:51.714612Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"with nc.Dataset(paths.grams_z500_patterns) as ds:\n    patterns = ds.variables[\"Z0500_mean\"][:]   # (7, 121, 241)\n    pat_names = ds.ClassNames.split()          # ['AT','ZO','ScTr','AR','EuBL','ScBL','GL']\n    lat_eof   = ds.variables[\"latitude\"][:]    # 30.0 … 90.0\n    lon_eof   = ds.variables[\"longitude\"][:]   # -80.0 … 40.0\n\nprint(f\"Patterns shape : {patterns.shape}  — {pat_names}\")\n\nwith open(paths.grams_std_params) as f:\n    f.readline()                                          # description\n    std_names = f.readline().split()                      # regime names\n    std_mean  = np.array(f.readline().split()[1:], dtype=float)\n    std_std   = np.array(f.readline().split()[1:], dtype=float)\n\nstd_df = pd.DataFrame({\"mean\": std_mean, \"std\": std_std}, index=std_names)\nprint(f\"\\nStandardisation parameters (1979-2019 reference):\")\nprint(std_df.T.to_string())","key":"I75SqKf5vc"},{"type":"outputs","id":"1BeAGT4fJAYHaz8x1Yv5T","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Patterns shape : (7, 121, 241)  — ['AT', 'ZO', 'ScTr', 'AR', 'EuBL', 'ScBL', 'GL']\n\nStandardisation parameters (1979-2019 reference):\n            AT        ZO      ScTr        AR      EuBL      ScBL        GL\nmean -0.002384 -0.007834 -0.001525  0.002115  0.004273  0.008984  0.004963\nstd   0.171129  0.281854  0.200427  0.249227  0.229233  0.233212  0.341543\n"},"children":[],"key":"q6MRDet6uN"}],"key":"uCyedMdxIf"}],"key":"Wm6iv00a68"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 3 — Load the example Z500 field","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Xao2iZYB6p"}],"identifier":"step-3-load-the-example-z500-field","label":"Step 3 — Load the example Z500 field","html_id":"step-3-load-the-example-z500-field","implicit":true,"key":"ZzLq828kGk"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"The bundled file ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dqhJyWtFVw"},{"type":"inlineCode","value":"Z0500_20250601_00.nc","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"gYhp78tFZo"},{"type":"text","value":" contains a single 10-day\nLanczos low-pass filtered Z500 anomaly field for 2025-06-01 00 UTC\n(Lanczos filter: 161 points at Δt = 3 h → 240 h cutoff).\nThe global field is cropped to the EOF domain before projection.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uuSXcX8Wf0"}],"key":"AX1b1eioxU"}],"key":"eCZPd4l5jV"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-15T08:56:51.716337Z","iopub.status.busy":"2026-05-15T08:56:51.716225Z","iopub.status.idle":"2026-05-15T08:56:51.722813Z","shell.execute_reply":"2026-05-15T08:56:51.722040Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"target_date = \"20250601_00\"\ndtime = datetime.datetime.strptime(target_date, \"%Y%m%d_%H\")\n\nwith nc.Dataset(paths.grams_example_z500) as ds:\n    lon_global = np.arange(ds.domxmin, ds.domxmax + 0.5, 0.5)\n    lat_global = np.arange(ds.domymin, ds.domymax + 0.5, 0.5)\n\n    # Crop to EOF domain: lon -80..40, lat 30..90\n    i1 = lon_global.tolist().index(-80.0);  i2 = lon_global.tolist().index(40.0) + 1\n    j1 = lat_global.tolist().index(30.0);   j2 = lat_global.tolist().index(90.0) + 1\n\n    z500 = ds.variables[\"Z0\"][0, 0, j1:j2, i1:i2].copy()   # (121, 241)\n\nprint(f\"Z500 field shape (EOF domain): {z500.shape}\")\nprint(f\"Value range: {z500.min():.1f} … {z500.max():.1f}  (geopotential metres, anomaly)\")","key":"cLOVm4joAx"},{"type":"outputs","id":"t7moKAj2UfzmuEIpMWEcv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Z500 field shape (EOF domain): (121, 241)\nValue range: -181.1 … 148.7  (geopotential metres, anomaly)\n"},"children":[],"key":"wxYgrIAdez"}],"key":"KvA8nysno2"}],"key":"CDWtsBtN0D"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 4 — Normalise by seasonal weight","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FIgQdYGFAh"}],"identifier":"step-4-normalise-by-seasonal-weight","label":"Step 4 — Normalise by seasonal weight","html_id":"step-4-normalise-by-seasonal-weight","implicit":true,"key":"tQH3LvnnW7"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The normwgt array covers 6-hourly steps of a single leap year.\nFor a non-leap year, index 236 (= 29 Feb 00 UTC) must be skipped.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RBJ21WViVR"}],"key":"gae8733r4B"}],"key":"xEN465wuV1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-15T08:56:51.724284Z","iopub.status.busy":"2026-05-15T08:56:51.724149Z","iopub.status.idle":"2026-05-15T08:56:51.727528Z","shell.execute_reply":"2026-05-15T08:56:51.727051Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"tdiff   = int((dtime - datetime.datetime(dtime.year, 1, 1)).total_seconds() / 3600)\ntdiff   = tdiff - tdiff % 6   # snap to 6-h grid\n\nif tdiff >= nrmtimes[236] and not calendar.isleap(dtime.year):\n    nj = nrmtimes.tolist().index(tdiff + 24)   # skip 29 Feb slot\nelse:\n    nj = nrmtimes.tolist().index(tdiff)\n\nprint(f\"Normwgt index: {nj}  →  weight = {normwgt[nj]:.6f}\")\nz500_norm = z500 / normwgt[nj]","key":"Oc5JAG7Xip"},{"type":"outputs","id":"8OUaQMGMRVV-OJAVHTqLP","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Normwgt index: 608  →  weight = 75.516769\n"},"children":[],"key":"yWFcQuES15"}],"key":"RyiyQAQDMo"}],"key":"OUk2dtYW0A"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 5 — Compute cosine-latitude-weighted projection","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hDZbUcPhtS"}],"identifier":"step-5-compute-cosine-latitude-weighted-projection","label":"Step 5 — Compute cosine-latitude-weighted projection","html_id":"step-5-compute-cosine-latitude-weighted-projection","implicit":true,"key":"mkVK6bmGjv"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The IWR is the cosine-latitude-weighted dot product of the normalised Z500\nanomaly with each regime pattern, then standardised.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JkVVkMENOY"}],"key":"GrXDy28P7m"}],"key":"fbjxllm5Jy"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-15T08:56:51.728792Z","iopub.status.busy":"2026-05-15T08:56:51.728681Z","iopub.status.idle":"2026-05-15T08:56:51.734287Z","shell.execute_reply":"2026-05-15T08:56:51.733858Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"d2r   = np.pi / 180.0\ncos2d = np.tile(np.cos(lat_eof * d2r)[:, np.newaxis], (1, len(lon_eof)))\ncos2d /= cos2d.sum()   # normalise so weights sum to 1\n\n# Project onto each pattern (patterns are stored in pat_names order)\nproj = np.zeros(7)\nfor w, name in enumerate(pat_names):\n    i_wr = WR_NAMES.index(name)\n    proj[i_wr] = np.sum(cos2d * patterns[w] * z500_norm)\n\n# Standardise → IWR\niwr = np.zeros(7)\nfor w, name in enumerate(WR_NAMES):\n    iwr[w] = (proj[w] - std_df.loc[name, \"mean\"]) / std_df.loc[name, \"std\"]\n\nresult = pd.Series(iwr, index=WR_NAMES, name=\"computed IWR\")\nprint(result.round(4).to_string())","key":"RUWx2P9bOK"},{"type":"outputs","id":"PvgbWZNGeW9uD6BTtVjlv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"AT      0.8218\nZO      1.1692\nScTr    1.0490\nAR     -0.6949\nEuBL   -0.5739\nScBL   -0.9323\nGL     -0.6369\n"},"children":[],"key":"IcDQmBXeKb"}],"key":"NdaJtnYl5v"}],"key":"ej4FYMsfJD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Step 6 — Compare with pre-computed values","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key