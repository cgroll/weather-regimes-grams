":3,"column":1},"end":{"line":3,"column":1}},"key":"NNXDx8FyIa"},{"type":"emphasis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"t + lag","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RTW5qKLqWy"}],"key":"qli0WYzFpx"},{"type":"text","value":":","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mbTuz849pf"}],"key":"amZkjcnfUE"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"CF_avg(t+lag) = mean( CF(t+lag), CF(t+lag+1), …, CF(t+lag+w-1) )","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"sz4JhJwZMl"}],"key":"s3vMH5d0fc"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Varying ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"mzGKwUun5R"},{"type":"emphasis","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"lag","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"cj3xgYYnUi"}],"key":"Cu5FGYBEmC"},{"type":"text","value":" tests predictive skill; varying ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"wGa2i2UgJm"},{"type":"emphasis","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"w","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"zB3DLpb65e"}],"key":"kGyQQ50hkg"},{"type":"text","value":" tests whether averaging the\ntarget over multiple days reveals a stronger large-scale signal.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Tu1UclMoiS"}],"key":"XaSyGFxXI1"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Combinations produced below: windows w ∈ {1, 2, 5} days × lags ∈ {0, 5, 15}\ndays (w=1, lag=0 is the simultaneous map already shown above).","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"muM21Lox3u"}],"key":"phETA7AFQM"}],"key":"CflfVi1Suh"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-22T06:27:10.770428Z","iopub.status.busy":"2026-05-22T06:27:10.770303Z","iopub.status.idle":"2026-05-22T06:27:23.644315Z","shell.execute_reply":"2026-05-22T06:27:23.643563Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"z500_np  = z500_sel.values   # (T, lat, lon)\nWINDOWS  = [1, 2, 5]\nLAG_DAYS = [0, 5, 15]\n\n\ndef forward_mean(arr: np.ndarray, w: int) -> np.ndarray:\n    \"\"\"Forward w-day mean: result[i] = mean(arr[i:i+w]).  Length = len(arr)-w+1.\"\"\"\n    if w == 1:\n        return arr.copy()\n    return np.convolve(arr, np.ones(w) / w, mode=\"valid\")\n\n\n# Pre-compute forward means for all window sizes\nwind_fwd  = {w: forward_mean(wind_sel,  w) for w in WINDOWS}\nsolar_fwd = {w: forward_mean(solar_sel, w) for w in WINDOWS}\n\n\ndef plot_corr_map(corr_w: np.ndarray, corr_s: np.ndarray,\n                  w: int, lag: int, n_pairs: int) -> plt.Figure:\n    lag_levels = np.linspace(-vmax, vmax, 21)\n    if lag == 0:\n        lead_str = \"simultaneous\"\n    else:\n        lead_str = f\"lead {lag} d\"\n    fig, axes = plt.subplots(\n        1, 2, figsize=(16, 6),\n        subplot_kw={\"projection\": PROJ},\n        constrained_layout=True,\n    )\n    for corr, var_label, ax in [\n        (corr_w, \"Wind onshore DE\", axes[0]),\n        (corr_s, \"Solar PV DE\",     axes[1]),\n    ]:\n        ax.set_extent(EXTENT, crs=TRANS)\n        ax.add_feature(cfeature.COASTLINE, linewidth=0.7)\n        ax.add_feature(cfeature.BORDERS,   linewidth=0.4, linestyle=\":\")\n        ax.add_feature(cfeature.LAND,      facecolor=\"#f5f5f5\", zorder=0)\n        cf = ax.contourf(\n            lons, lats, corr.T,\n            levels=lag_levels, cmap=\"RdBu_r\", transform=TRANS, extend=\"both\",\n        )\n        ax.contour(\n            lons, lats, corr.T,\n            levels=[0], colors=\"k\", linewidths=0.8, transform=TRANS,\n        )\n        cb = plt.colorbar(cf, ax=ax, orientation=\"vertical\", pad=0.03,\n                          fraction=0.04, label=\"Pearson r\")\n        cb.ax.tick_params(labelsize=9)\n        ax.set_title(f\"Z500(t) → {var_label} {w}d-avg (t+{lag}d)\", fontsize=12)\n        ax.gridlines(draw_labels=True, linewidth=0.3, color=\"grey\", alpha=0.5,\n                     x_inline=False, y_inline=False)\n    fig.suptitle(\n        f\"CF {w}-day average, {lead_str}  \"\n        f\"({common[0].year}–{common[-1].year}, n={n_pairs} pairs)\",\n        fontsize=13, y=1.01,\n    )\n    return fig\n\n\nfor w in WINDOWS:\n    for lag in LAG_DAYS:\n        if w == 1 and lag == 0:\n            continue  # already produced as the simultaneous figure above\n        cf_wind_w  = wind_fwd[w]    # length T-w+1\n        cf_solar_w = solar_fwd[w]   # length T-w+1\n        n = len(cf_wind_w) - lag    # valid pairs\n        z500_slice  = z500_np[:n]\n        wind_slice  = cf_wind_w[lag:lag + n]\n        solar_slice = cf_solar_w[lag:lag + n]\n\n        print(f\"w={w}d lag={lag:2d}d — computing …\", end=\" \", flush=True)\n        cw = pointwise_corr(z500_slice, wind_slice)\n        cs = pointwise_corr(z500_slice, solar_slice)\n        print(f\"wind max|r|={np.nanmax(np.abs(cw)):.3f}  \"\n              f\"solar max|r|={np.nanmax(np.abs(cs)):.3f}\")\n\n        fig  = plot_corr_map(cw, cs, w, lag, n)\n        fname = paths.images_path / f\"20_z500_cf_corr_w{w}d_lag{lag:02d}d.png\"\n        fig.savefig(fname, dpi=150, bbox_inches=\"tight\")\n        plt.close(fig)\n        print(f\"  Saved → {fname.name}\")","key":"ONe0yLzqBv"},{"type":"outputs","id":"WEODFb4xKOFIhxVOl5q6H","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"w=1d lag= 5d — computing … "},"children":[],"key":"QLDhuS9gZm"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"wind max|r|=0.156  solar max|r|=0.119\n"},"children":[],"key":"FiO6SVXFXG"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  Saved → 20_z500_cf_corr_w1d_lag05d.png\nw=1d lag=15d — computing … "},"children":[],"key":"emVTmJzyFv"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"wind max|r|=0.045  solar max|r|=0.038\n"},"children":[],"key":"LJXC8HUAbx"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  Saved → 20_z500_cf_corr_w1d_lag15d.png\nw=2d lag= 0d — computing … "},"children":[],"key":"AOul09wd8k"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"wind max|r|=0.502  solar max|r|=0.378\n"},"children":[],"key":"zaOlrJTD3e"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  Saved → 20_z500_cf_corr_w2d_lag00d.png\nw=2d lag= 5d — computing … "},"children":[],"key":"qKJvX7OfKx"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"wind max|r|=0.152  solar max|r|=0.121\n"},"children":[],"key":"QOztuCmU5M"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  Saved → 20_z500_cf_corr_w2d_lag05d.png\nw=2d lag=15d — computing … "},"children":[],"key":"qkHg7gxn1X"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"wind max|r|=0.053  solar max|r|=0.042\n"},"children":[],"key":"Ny6KuOervM"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  Saved → 20_z500_cf_corr_w2d_lag15d.png\nw=5d lag= 0d — computing … "},"children":[],"key":"y80Sv6SLBO"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"wind max|r|=0.459  solar max|r|=0.356\n"},"children":[],"key":"IAH8Wyjz51"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  