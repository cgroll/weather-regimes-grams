smoothed\nday-of-year climatology (4 harmonics, computed from the same 1979–2021\nperiod used for correlation).","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"TXYynGeS8j"}],"key":"gJDOFEXC2L"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"The two datasets overlap over ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"ecxmxg5IDF"},{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"1979-01-01 → 2021-12-31","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"yEJykC50qL"}],"key":"NoXWbKOgrH"},{"type":"text","value":" (≈ 15 700 days).","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"MHPwN0O5C4"}],"key":"DMfcOYXPfO"}],"key":"os9QXMAFLF"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-22T06:27:05.599399Z","iopub.status.busy":"2026-05-22T06:27:05.599207Z","iopub.status.idle":"2026-05-22T06:27:06.361907Z","shell.execute_reply":"2026-05-22T06:27:06.361419Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport pandas as pd\nimport xarray as xr\nimport matplotlib.pyplot as plt\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\n\nfrom wr.paths import ProjPaths\n\npaths = ProjPaths()\n\nPECD_PATH = \"/home/chris/research/world-of-energy/data/processed/pecd/pecd_regions.parquet\"\nIMG_OUT   = paths.images_path / \"20_z500_cf_correlation.png\"","key":"VHrURGLfA5"},{"type":"outputs","id":"eUl10izmMdpamJ-udeJpO","children":[],"key":"EMN66TGtQR"}],"key":"yQY5vlPE0s"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load and align Z500","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AMrC41Q9Wr"}],"identifier":"load-and-align-z500","label":"Load and align Z500","html_id":"load-and-align-z500","implicit":true,"key":"jfSFv1dub5"}],"key":"uMSXZZLWU7"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-22T06:27:06.364306Z","iopub.status.busy":"2026-05-22T06:27:06.363898Z","iopub.status.idle":"2026-05-22T06:27:07.196966Z","shell.execute_reply":"2026-05-22T06:27:07.196229Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"print(\"Loading ERA5 Z500 …\")\nz500_ds = xr.open_zarr(str(paths.era5_z500_daily_zarr))[\"z500\"].load()\n\nprint(\"Loading WB2 Z500 climatology …\")\nclim = xr.open_zarr(str(paths.wb_z500_climatology))[\"z500\"].load()\n\n# Compute anomaly\ndoy = z500_ds.time.dt.dayofyear\nz500_anom = (z500_ds - clim.sel(dayofyear=doy)).rename(\"z500_anom\")\n\n# Normalise time index to date-only for joining with PECD daily series\nz500_dates = pd.to_datetime(z500_anom.time.values).normalize()\nz500_anom  = z500_anom.assign_coords(time=z500_dates)\n\n# Filter to PECD overlap period: 1979–2021\nz500_anom = z500_anom.sel(time=slice(\"1979-01-01\", \"2021-12-31\"))\nprint(f\"Z500 anomaly: {str(z500_anom.time.values[0])[:10]} → \"\n      f\"{str(z500_anom.time.values[-1])[:10]}, n={len(z500_anom.time)}\")","key":"cq7KZiwmOP"},{"type":"outputs","id":"r2hkzed-tLTGylY-0b-Qz","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Loading ERA5 Z500 …\n"},"children":[],"key":"TRrFLuNJGP"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Loading WB2 Z500 climatology …\n"},"children":[],"key":"CW4OnjR833"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Z500 anomaly: 1979-01-01 → 2021-12-31, n=15706\n"},"children":[],"key":"XyvdLommJR"}],"key":"ygSOQn4CZM"}],"key":"wNANZA9bE2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load and prepare PECD capacity factors","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FHXIts3c2V"}],"identifier":"load-and-prepare-pecd-capacity-factors","label":"Load and prepare PECD capacity factors","html_id":"load-and-prepare-pecd-capacity-factors","implicit":true,"key":"SUP9yvCl64"}],"key":"X63Jv10EGP"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-22T06:27:07.198556Z","iopub.status.busy":"2026-05-22T06:27:07.198381Z","iopub.status.idle":"2026-05-22T06:27:08.920545Z","shell.execute_reply":"2026-05-22T06:27:08.919972Z"},"lines_to_next_cell":1},"children":[{"type":"code","lang":"python","executable":true,"value":"print(\"Loading PECD …\")\npecd = pd.read_parquet(PECD_PATH)\n\nde_wind_h  = pecd[(\"wind_power_generation_onshore\",       \"capacity_factor_ratio\", \"DE\")]\nde_solar_h = pecd[(\"solar_photovoltaic_power_generation\", \"capacity_factor_ratio\", \"DE\")]\n\n# Resample to daily means\nde_wind_d  = de_wind_h.resample(\"D\").mean()\nde_solar_d = de_solar_h.resample(\"D\").mean()\n\n# Filter to same overlap period\nde_wind_d  = de_wind_d[\"1979\":\"2021\"]\nde_solar_d = de_solar_d[\"1979\":\"2021\"]\n\nprint(f\"Wind  daily: {de_wind_d.index[0].date()} → {de_wind_d.index[-1].date()}, \"\n      f\"n={len(de_wind_d)}, NaN={de_wind_d.isna().sum()}\")\nprint(f\"Solar daily: {de_solar_d.index[0].date()} → {de_solar_d.index[-1].date()}, \"\n      f\"n={len(de_solar_d)}, NaN={de_solar_d.isna().sum()}\")","key":"wtJScKni7Y"},{"type":"outputs","id":"FE8P2khAlFXuP7lMCrnrA","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Loading PECD …\n"},"children":[],"key":"l79Z6R9uLH"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Wind  daily: 1979-01-01 → 2021-12-31, n=15706, NaN=0\nSolar daily: 1979-01-01 → 2021-12-31, n=15706, NaN=0\n"},"children":[],"key":"pdmzhQYtoo"}],"key":"EEEfBaLSd7"}],"key":"YMRn6W9Pi7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compute CF day-of-year climatology (Fourier, 4 harmonics)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WzzbQE4UX5"}],"identifier":"compute-cf-day-of-year-climatology-fourier-4-harmonics","label":"Compute CF day-of-year climatology (Fourier, 4 harmonics)","html_id":"compute-cf-day-of-year-climatology-fourier-4-harmonics","implicit":true,"key":"H6QqGfGqZe"}],"key":"oDNHkz2TkJ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-22T06:27:08.921849Z","iopub.status.busy":"2026-05-22T06:27:08.921734Z","iopub.status.idle":"2026-05-22T06:27:08.937429Z","shell.execute_reply":"2026-05-22T06:27:08.937014Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def fourier_climatology(values: np.ndarray, n_harmonics: int = 4) -> np.ndarray:\n    N = len(values)\n    t = np.arange(N)\n    omega = 2 * np.pi * t / N\n    smooth = np.full(N, np.mean(values), dtype=float)\n    for h in range(1, n_harmonics + 1):\n        cc = np.mean(values * np.cos(h * omega)) * 2\n        sc = np.mean(values * np.sin(h * omega)) * 2\n        smooth += cc * np.cos(h * omega) + sc * np.sin(h * omega)\n    return smooth\n\n\ndef compute_cf_anomaly(series: pd.Series) -> pd.Series:\n    \"\"\"Subtract Fourier-smoothed day-of-year climatology from a daily series.\"\"\"\n    g = series.groupby([series.index.month, series.index.day])\n    raw_clim = g.mean()                         # multi-index (month, day)\n    smooth   = fourier_climatology(raw_clim.values, n_harmonics=4)\n\n    clim_map = {key: val for key, val in zip(raw_clim.index, smooth)}\n\n    doy_keys = list(zip(series.index.month, series.index.day))\n    clim_vals = np.array([clim_map[k] for k in doy_keys])\n    return series - clim_vals\n\n\nwind_anom  = compute_cf_anomaly(de_wind_d)\nsolar_anom = compute_cf_anomaly(de_solar_d)\n\nprint(f\"Wind  anom: mean={wind_anom.mean():.4f}, std={wind_anom.std():.4f}\")\nprint(f\"Solar anom: mean={solar_anom.mean():.4f}, std={solar_anom.std():.4f}\")","key":"tMJEqNWKnN"},{"type":"outputs","id":"thEF2xpY1mAGFS-cI872O","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Wind  anom: mean=-0.0001, std=0.2107\nSolar anom: mean=0.0000, std=0.0584\n"},"children":[],"key":"Btl0mKR9hM"}],"key":"bpmI9zXDo0"}],"key":"I9kl0K4clZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Align time indices and compute pointwise correlations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cRIkBKUkTU"}],"identifier":"align-time-indices-and-compute-pointwise-correlations","label":"Align time indices and compute pointwise correlations","html_id":"align-time-indices-and-compute-pointwise-correlations","implicit":true,"key":"kfBaiGZYtW"}],"key":"dNm0cRB9lX"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-22T06:27:08.938854Z","iopub.status.busy":"2026-05-22T06:27:08.938744Z","iopub.status.idle":"2026-05-22T06:27:10.094919Z","shell.execute_reply":"2026-05-22T06:27:10.094286Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Use the intersection of dates present in both datasets\nz500_date_index = pd.DatetimeIndex(z500_anom.time.values)\ncommon = z500_date_index.intersection(wind_anom.index)\nprint(f\"Common dates: {common[0].date()} → {common[-1].date()}, n={len(common)}\")\n\nz500_sel  = z500_anom.sel(time=common)          # (T, lat, lon)\nwind_sel  = wind_anom.reindex(common).values    # (T,)\nsolar_sel = solar_anom.reindex(common).values   # (T,)\n\n# Vectorised Pearson correlation over the time axis\ndef pointwise_corr(field: np.ndarray, ts: np.ndarray) -> np.ndarray:\n    \"\"\"Pearson r between each (lat, lon) time series and ts.  field: (T, lat, lon).\"\"\"\n    T = field.shape[0]\n    f_mean = field.mean(axis=0)            # (lat, lon)\n    t_mean = ts.mean()\n    f_c = field - f_mean                   # (T, lat, lon)\n    t_c = ts - t_mean                      # (T,)\n    cov  = (f_c * t_c[:, None, None]).mean(axis=0)\n    f_std = f_c.std(axis=0)\n    t_std = t_c.std()\n    with np.errstate(invalid=\"ignore\"):\n        r = cov / (f_std * t_std)\n    return r\n\n\nprint(\"Computing wind correlation …\")\ncorr_wind  = pointwise_corr(z500_sel.values, wind_sel)\n\nprint(\"Computing solar correlation …\")\ncorr_solar = pointwise_corr(z500_sel.values, solar_sel)\n\nlats = z500_sel.latitude.values\nlons = z500_sel.longitude.values\n\nprint(f\"Wind  corr: min={np.nanmin(corr_wind):.3f}, max={np.nanmax(corr_wind):.3f}\")\nprint(f\"Solar corr: min={np.nanmin(corr_solar):.3f}, max={np.nanmax(corr_solar):.3f}\")","key":"ah7StzleYS"},{"type":"outputs","id":"BCj46bFBGIuFPlO1uMI12","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Common dates: 1979-01-01 → 2021-12-31, n=15706\nComputing wind correlation …\n"},"children":[],"key":"ti2Q3MFBsW"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Computing solar correlation …\n"},"children":[],"key":"GpO1hC8QOa"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Wind  corr: min=-0.500, max=0.297\nSolar corr: min=-0.228, max=0.361\n"},"children":[],"key":"pY3O1VhQSi"}],"key":"cXS3Ibwoet"}],"key":"rgYC3LpTJM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Correlation maps","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"z2FESTuc47"}],"identifier":"correlation-maps","label":"Correlation maps","html_id":"correlation-maps","implicit":true,"key":"G32MZFYxyn"}],"key":"f02cCNaCuS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-05-22T06:27:10.096399Z","iopub.status.busy":"2026-05-22T06:27:10.096278Z","iopub.status.idle":"2026-05-22T06:27:10.769312Z","shell.execute_reply":"2026-05-22T06:27:10.768639Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"PROJ  = ccrs.PlateCarree()\nTRANS = ccrs.PlateCarree()\nEXTENT = [-80, 41, 29, 91]\n\nvmax = max(\n    np.nanmax(np.abs(corr_wind)),\n    np.nanmax(np.abs(corr_solar)),\n)\nvmax = round(min(vmax, 1.0), 2)\nlevels = np.linspace(-vmax, vmax, 21)\n\nfig, axes = plt.subplots(\n    1, 2, figsize=(16, 6),\n    subplot_kw={\"projection\": PROJ},\n    constrained_layout=True,\n)\n\npanels = [\n    (corr_wind,  \"Wind onshore DE\",  axes[0]),\n    (corr_solar, \"Solar PV DE\",      axes[1]),\n]\n\nfor corr, title, ax in panels:\n    ax.set_extent(EXTENT, crs=TRANS)\n    ax.add_feature(cfeature.COASTLINE, linewidth=0.7)\n    ax.add_feature(cfeature.BORDERS,   linewidth=0.4, linestyle=\":\")\n    ax.add_feature(cfeature.LAND,      facecolor=\"#f5f5f5\", zorder=0)\n    cf = ax.contourf(\n        lons, lats, corr.T,\n        levels=levels, cmap=\"RdBu_r\", transform=TRANS, extend=\"both\",\n    )\n    ax.contour(\n        lons, lats, corr.T,\n        levels=[0], colors=\"k\", linewidths=0.8, transform=TRANS,\n    )\n    cb = plt.colorbar(cf, ax=ax, orientation=\"vertical\", pad=0.03, fraction=0.04,\n                      label=\"Pearson r\")\n    cb.ax.tick_params(labelsize=9)\n    ax.set_title(f\"Z500 anomaly correlation — {title}\", fontsize=12)\n    ax.gridlines(draw_labels=True, linewidth=0.3, color=\"grey\", alpha=0.5,\n                 x_inline=False, y_inline=False)\n\nfig.suptitle(\n    f\"Pointwise Z500–CF correlation  ({common[0].year}–{common[-1].year}, daily)\",\n    fontsize=13, y=1.01,\n)\n\nfig.savefig(IMG_OUT, dpi=150, bbox_inches=\"tight\")\nplt.show()\nprint(f\"Saved → {IMG_OUT}\")","key":"HCkFJxkzqE"},{"type":"outputs","id":"It5ZN0ZCHOQLTd46ToWdd","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved → /home/chris/research/weather-regimes-grams/output/images/20_z500_cf_correlation.png\n"},"children":[],"key":"zKgTwoC0Ta"},{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_1358743/348746057.py:49: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"NYYBDkEMvl"}],"key":"n54kK5OGa7"}],"key":"Ii98RnnIIs"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/weather-regimes-grams/build/20_z500_cf_correlati-547eb689125a40b7006812e36c963cb1.png","alt":"Pearson correlation between the daily Z500 anomaly at each Euro-Atlantic grid\npoint and the daily capacity-factor anomaly for Germany wind onshore (left)\nand Germany solar PV (right).  Period: 1979–2021.  Red = positive correlation;\nblue = negative.  The zero-correlation contour is shown in black.","data":{"altTextIsAutoGenerated":true},"key":"sSmZujoxct","urlSource":"../../output/images/20_z500_cf_correlation.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig-20-z500-cf-correlation","identifier":"fig-20-z500-cf-correlation","html_id":"fig-20-z500-cf-correlation","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"CVFvWrrmnV"},{"type":"text","value":"1","key":"jsFYjNZtmi"},{"type":"text","value":":","key":"VD06ngpBwV"}],"template":"Figure %s:","key":"MKTrBRusly"},{"type":"text","value":"Pearson correlation between the daily Z500 anomaly at each Euro-Atlantic grid\npoint and the daily capacity-facto